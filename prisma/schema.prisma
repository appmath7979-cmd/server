// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Region {
  MB
  MT
  MN
}

model Customer {
  id          String         @id @default(uuid())
  fullName    String
  phoneNumber String         @unique
  type        CustomerType
  status      CustomerStatus @default(ACTIVE)
  tinhUi      Boolean
  xienMienBac Boolean
  settings    Json
  orders      Order[]
  daxt        String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User?    @relation(fields: [userId], references: [id])
  userId    String?
}

enum CustomerType {
  OWNER
  GUEST
}

enum DaType {
  MOT_LAN
  KY_RUOI
  NHIEU_CAP
}

enum CustomerStatus {
  ACTIVE
  INACTIVE
}

model Order {
  id         String         @id @default(uuid())
  release    String
  isLayoff   Boolean
  region     Region
  message    String
  details    OrderDetails[]
  isSend     Boolean?       @default(false)
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt
  customer   Customer?      @relation(fields: [customerId], references: [id], onDelete: Cascade)
  customerId String?

  @@index([customerId])
  @@index([release])
}

model OrderDetails {
  id         String  @id @default(uuid())
  customerId String?
  date       String

  syntax      String
  stationCode String
  number      String
  type        String @default("bao")

  price Float
  xac   Float
  co    Float
  trung Float @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId   String

  @@index([date, customerId])
}

model Setting {
  id           String   @id @default(uuid())
  day          Int
  syntax       String
  provinceCode String
  region       Region
  score        Int
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([day, syntax, region, provinceCode])
}

model Reward {
  id           String @id @default(uuid())
  provinceCode String
  release      String
  region       Region

  gdb       String[]
  g1        String[]
  g2        String[]
  g3        String[]
  g4        String[]
  g5        String[]
  g6        String[]
  g7        String[]
  g8        String[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([provinceCode, release])
  @@index([release, region])
}

model User {
  id          String     @id @default(uuid())
  username    String     @unique()
  phoneNumber String     @unique()
  password    String
  status      UserStatus
  customers   Customer[]
  type        UserType   @default(GUEST)

  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  userConnections UserConnection[]
}

enum PaymentStatus {
  IDLE
  PENDING
  SUCCESS
  ERROR
}

enum UserType {
  ADMIN
  GUEST
}

enum UserStatus {
  ACTIVE
  INACTIVE
  FROZEN
}

model UserConnection {
  id       String  @id @default(uuid())
  userId   String?
  targetId String

  user User? @relation(fields: [userId], references: [id])

  @@unique([userId, targetId])
}

model Report {
  id        String         @id @default(uuid())
  release   String
  details   ReportDetail[]
  total     Float          @default(0)
  totalMB   Float          @default(0)
  totalMT   Float          @default(0)
  totalMN   Float          @default(0)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
}

model ReportDetail {
  id           String @id @default(uuid())
  region       Region
  release      String
  value        Float
  type         String
  syntax       String
  provinceCode String
  number       String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  report    Report?  @relation(fields: [reportId], references: [id])
  reportId  String?
}
