// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Region {
  MB
  MT
  MN
}

model Customer {
  id          String         @id @default(uuid())
  fullName    String
  phoneNumber String         @unique
  type        CustomerType
  status      CustomerStatus @default(ACTIVE)
  tinhUi      Boolean
  xienMienBac Boolean
  settings    Json
  orders      Order[]
  dat         String
  daxt        String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum CustomerType {
  OWNER
  GUEST
}

enum DaType {
  MOT_LAN
  KY_RUOI
  NHIEU_CAP
}

enum CustomerStatus {
  ACTIVE
  INACTIVE
}

model Order {
  id         String         @id @default(uuid())
  release    String
  isLayoff   Boolean
  region     Region
  message    String
  details    OrderDetails[]
  isSend     Boolean?       @default(false)
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt
  customer   Customer?      @relation(fields: [customerId], references: [id], onDelete: Cascade)
  customerId String?

  @@index([customerId])
  @@index([release])
}

model OrderDetails {
  id         String  @id @default(uuid())
  customerId String?
  date       String

  syntax      String
  stationCode String
  number      String
  type        String @default("bao")

  price Float
  xac   Float
  co    Float
  trung Float @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId   String

  @@index([date, customerId])
}

model Setting {
  id           String   @id @default(uuid())
  day          Int
  syntax       String
  provinceCode String
  region       Region
  score        Int
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([day, syntax, region, provinceCode])
}
