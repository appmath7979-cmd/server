// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Reward {
  id        String         @id @default(uuid())
  rewards   RegionReward[]
  release   String
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@index([release])
}

model RegionReward {
  id        String   @id @default(uuid())
  region    Region
  station   String
  results   Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  reward    Reward?  @relation(fields: [rewardId], references: [id])
  rewardId  String?

  @@index([rewardId])
}

enum Region {
  SOUTH
  NORTH
  CENTRAL
}

model User {
  id        String     @id @default(uuid())
  username  String     @unique
  password  String
  type      UserType
  customers Customer[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@index([id])
  @@index([username])
}

enum UserType {
  ADMIN
  USER
}

model Customer {
  id           String       @id @default(uuid())
  fullName     String       @unique
  phoneNumber  String       @unique
  type         CustomerType
  loaiCo       String
  xienMB       Boolean
  tinhUi       Boolean
  tinhTrungDaT String
  tinhTrungDaX String
  settings     Json

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User?    @relation(fields: [userId], references: [id])
  userId    String?

  @@index([userId])
}

enum CustomerType {
  GUEST
  OWNER
}
